{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "automerge": true,
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ]
    },
    {
      "changelogUrl": "https://codeberg.org/bookstack/bookstack/releases",
      "matchPackageNames": [
        "lscr.io/linuxserver/bookstack"
      ],
      "sourceUrl": "https://github.com/BookStackApp/BookStack"
    }
  ]
}
