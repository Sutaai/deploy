[Unit]
Description=rclone - Boxy acess
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=root
ExecStart=/usr/bin/rclone --config /home/anna/.config/rclone/rclone.conf mount Boxy: /mnt/boxy --vfs-cache-mode writes --vfs-cache-max-age 6h --vfs-fast-fingerprint --allow-non-empty --allow-other
ExecStop=/usr/bin/fusermount -zu /mnt/boxy
TimeoutSec=30s
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
